# Copy to .env and fill in real values. Never commit .env.

victron_token=example
erp_token=example
workTLD=example.com
pcuser=YOUR_WINDOWS_USERNAME
idUser=example
username=example

fishuser=example
fishpass=example
switchuser=example
switchpass=example
pveuser=example@pam
pvepass=example
# SSH to PVE host for qm commands — Linux user only (no @pam). Falls back to pveuser sans realm.
pvesshuser=root
nucuser=example
nucpass=example
scryptuserssh=example
scryptuserweb=admin
scryptpass=example
install=example-install-command

# Optional: override default Documents\Sentra_Network_toolv19 path
# SENTRA_NETWORK_TOOL_V19_DIR=C:\Users\YOUR_WINDOWS_USERNAME\Documents\Sentra_Network_toolv19

# Optional external tool URLs (defaults match Sentra production hosts)
# MESH_BASE_URL=https://meshcentral.example.com/login?filter=
# RAINDANCE_BASE_URL=https://raindance.example.net/unit/
# ART form-login report (default: NOC outage / recovery email, reportId=153)
# ART_DATA_URL=https://art.sentracam.com/art/selectReportParameters?reportId=153
# Optional: seconds between automatic ART spreadsheet refreshes (default 3600)
# ART_REPORT_REFRESH_SECONDS=3600

# ART form login (Recovery Email / art_get.py) — not HTTP basic auth
myemail=example@example.com
mypass=example

# Zabbix (zabbix_tool.py / page_file.py)
zab_url=https://zabbix.example.com/api_jsonrpc.php
zab_token=example

cxtmanager=example@example.com
nocmanager=example@example.com
PAUSE_AUTOMATED_TASKS=0
# 1 = ERP-mutating dashboard actions stay visible but disabled (and POST routes 403).
# 0 = allow Set Fields, Create Project, Terminate/Activate Site, Clear MU, Tech Checks, etc.
# Resolve (R) is local-only and is never blocked by this flag.
DISABLE_ERP_WRITES=1

# Optional runtime (set by run_live.bat / run_sandbox.bat instead of editing here)
# WORK_TOOL_ENV=live
# WORK_TOOL_PORT=5000
# WORK_TOOL_DATA_DIR=
# WORK_TOOL_URL=http://127.0.0.1:5000
